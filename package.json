{
  "name": "branding-catalyst",
  "private": true,
  "type": "module",
  "description": "Branding Catalyst company website: static pages in public/, Node server (server.js) with API routes in api/",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js --dev",
    "build:pages": "node scripts/build.cjs && node scripts/check.cjs",
    "check": "node scripts/check.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "nodemailer": "10.2.1"
  }
}
