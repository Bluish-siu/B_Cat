# Copy these into Vercel → Project → Settings → Environment Variables (not into a file in this repo).
# See docs/SETUP.md for step-by-step setup.

# ARC AI answers (api/arc.js) and ARC lead cards (api/lead.js). Without it, ARC uses its built-in answers.
ANTHROPIC_API_KEY=
# Optional: Claude model (default claude-haiku-5-5; claude-sonnet-5-5 or claude-opus-5-5 for richer answers at higher cost)
ARC_MODEL=

# Lead email, option A: Hostinger SMTP (recommended)
SMTP_USER=hello@brandingcatalyst.in
SMTP_PASS=
# Optional (defaults shown)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# Lead email, option B: Resend (instead of SMTP)
RESEND_API_KEY=
LEAD_FROM_EMAIL=

# Where emails go (defaults shown)
LEAD_TO_EMAIL=hello@brandingcatalyst.in
HR_EMAIL=hr@brandingcatalyst.in

# Leads Google Sheet (docs/leads-sheet.gs)
LEADS_SHEET_URL=
LEADS_SHEET_SECRET=
