# Copy these into Vercel → Project → Settings → Environment Variables (not into a file in this repo).

# ARC AI answers (api/arc.js). Without it, ARC uses its built-in answers.
ANTHROPIC_API_KEY=
# Optional: Claude model for ARC (default claude-haiku-5-5; claude-sonnet-5-5 or claude-opus-5-5 for richer answers at higher cost)
ARC_MODEL=

# Optional: email every lead (api/lead.js). Without these, leads appear in Vercel → Logs (search LEAD).
RESEND_API_KEY=
LEAD_TO_EMAIL=hello@brandingcatalyst.in
# Job applications from the Careers page (default hr@brandingcatalyst.in)
HR_EMAIL=hr@brandingcatalyst.in
# Sender shown on lead emails (default: Branding Catalyst Website <website@brandingcatalyst.in>)
LEAD_FROM_EMAIL=
